# <rows>:<columns>:<startx>:<starty>:<width>:<height>
#
# Set to [2] | 1 . Two Thirds of Desktop
ctrl + alt - e    : yabai -m window --grid 1:3:0:0:2:1
# Set to [1] | 1 . Half of desktop
ctrl + alt - left : yabai -m window --grid 1:2:0:0:1:1

meh - 1 : yabai -m window --display 1
meh - 2 : yabai -m window --display 2
